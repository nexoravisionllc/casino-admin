# Copy to .env and adjust. Real environment variables override this file.

# HTTP listener (the frontend expects http://localhost:5100).
HOST=localhost
PORT=5100

# Set when running behind a reverse proxy (IIS/ARR, nginx) so X-Forwarded-Proto /
# X-Forwarded-Host are honored: true, a hop count, or e.g. "loopback".
TRUST_PROXY=
# Optional fixed base for uploaded image URLs, e.g. https://adminbackend.example.com
PUBLIC_BASE_URL=

# Shared "Solution" MySQL 8+ (or MariaDB 10.5+) database. The database and its
# tables are created on startup if missing (the user needs CREATE privileges then).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Solution
DB_CONNECTION_LIMIT=10
# Alternatively one URL, which overrides the DB_* values above:
# DATABASE_URL=mysql://user:password@localhost:3306/Solution

# One-time data copy from the old SQL Server database: npm run migrate:mssql
#   Windows auth (needs msnodesqlv8 + a SQL Server ODBC driver):
#     Server=localhost;Database=Solution;Trusted_Connection=True;TrustServerCertificate=True;
#   SQL login: Server=localhost;Database=Solution;User Id=sa;Password=...;TrustServerCertificate=True;
MSSQL_CONNECTION_STRING=Server=localhost;Database=Solution;Trusted_Connection=True;TrustServerCertificate=True;
# ODBC driver for Windows auth; auto-detected when blank.
DB_ODBC_DRIVER=

JWT_KEY=change-me-to-a-long-random-secret
JWT_ISSUER=AdminBackend
JWT_AUDIENCE=AdminFrontend
JWT_EXPIRES_HOURS=12

# Comma-separated origins for the admin front and the user front page.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173

# Shared secret the user backend sends as X-Notify-Secret to /api/wallet/notify.
NOTIFY_SECRET=change-me

# The user backend, which sends the crypto payout when a crypto withdrawal is
# accepted here (authenticated with NOTIFY_SECRET).
USER_BACKEND_URL=http://localhost:5090

FORTUNEGATE_BASE_URL=https://agentapi.fortunegate.net
FORTUNEGATE_TOKEN=
FORTUNEGATE_LANG=1
FORTUNEGATE_AGENT_INFO_INTERVAL_SECONDS=5
